{
    "manifest_version": 3,
    "name": "HahaNewTab - 新标签页导航",
    "short_name": "HahaNewTab",
    "version": "1.0.1.11",
    "description": "统一管理和快速访问各类开发者工具和外部链接的应用导航中心",
    "author": "HahaNewTab",
    "homepage_url": "https://github.com/AlexCat315/HahaNewTab",
    "icons": {
        "16": "image/logo/logo_girl-16.png",
        "32": "image/logo/logo_girl-32.png",
        "48": "image/logo/logo_girl-48.png",
        "128": "image/logo/logo_girl-128.png"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "chrome_settings_overrides": {
        "homepage": "index.html"
    },
    "action": {
        "default_popup": "view/popup.html",
        "default_title": "添加网站到 HahaNewTab",
        "default_icon": {
            "16": "image/logo/logo_girl-16.png",
            "32": "image/logo/logo_girl-32.png"
        }
    },
    "permissions": [
        "storage",
        "unlimitedStorage",
        "activeTab",
        "tabs"
    ],
    "optional_permissions": [
        "bookmarks"
    ],
    "host_permissions": [
        "http://*/",
        "https://*/"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "js/*",
                "view/*",
                "image/*",
                "config/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "background": {
        "scripts": [
            "js/background-firefox.js"
        ]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "{8f0e09af-c367-46bf-bab8-fc88cbc885c1}",
            "strict_min_version": "115.0",
            "update_url": "https://github.com/AlexCat315/HahaNewTab/releases/latest/download/updates.json",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}
